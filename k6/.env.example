# URLs das 6 Lambdas (Lambda Function URL — output do Terraform: lambda_function_urls)
# Obtenha com: terraform output -json lambda_function_urls
URL_GO_CPU=https://example.lambda-url.us-east-1.on.aws/
URL_GO_PARALLEL=https://example.lambda-url.us-east-1.on.aws/
URL_GO_IO=https://example.lambda-url.us-east-1.on.aws/
URL_QUARKUS_CPU=https://example.lambda-url.us-east-1.on.aws/
URL_QUARKUS_PARALLEL=https://example.lambda-url.us-east-1.on.aws/
URL_QUARKUS_IO=https://example.lambda-url.us-east-1.on.aws/

# Selecionar targets: "all" ou lista separada por vírgula
# Ex: go-cpu,quarkus-cpu
TARGETS=all

# Payloads enviados às Lambdas
PAYLOAD_CPU_NUMBER=999999999989
PAYLOAD_PARALLEL_TASKS=5000

# Perfil Spike (cold start)
SPIKE_IDLE_DURATION=5m
SPIKE_SPIKE_DURATION=30s
SPIKE_PEAK_VUS=100
SPIKE_CYCLES=3

# Perfil Load (warm start)
LOAD_RAMP_UP_DURATION=2m
LOAD_STEADY_DURATION=10m
LOAD_RAMP_DOWN_DURATION=2m
LOAD_STEADY_VUS=50

# Opcionais
HTTP_TIMEOUT=60s
GRACEFUL_RAMP_DOWN=30s
THRESHOLD_HTTP_FAIL_RATE=0.05
THRESHOLD_SUCCESS_RATE=0.95
THRESHOLD_P95_GO_MS=30000
THRESHOLD_P95_QUARKUS_MS=30000
