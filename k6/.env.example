# URLs das 6 Lambdas (Lambda Function URL — output do Terraform: lambda_function_urls)
# Obtenha com: terraform output -json lambda_function_urls
URL_GO_CPU=https://example.lambda-url.us-east-1.on.aws/
URL_GO_PARALLEL=https://example.lambda-url.us-east-1.on.aws/
URL_GO_IO=https://example.lambda-url.us-east-1.on.aws/
URL_QUARKUS_CPU=https://example.lambda-url.us-east-1.on.aws/
URL_QUARKUS_PARALLEL=https://example.lambda-url.us-east-1.on.aws/
URL_QUARKUS_IO=https://example.lambda-url.us-east-1.on.aws/

# Selecionar targets: "all" ou lista separada por vírgula
# Ex: go-cpu,quarkus-cpu
TARGETS=all

# Payloads enviados às Lambdas
PAYLOAD_CPU_NUMBER=999999999989
PAYLOAD_PARALLEL_TASKS=5000

# Perfil Spike (cold start)
SPIKE_IDLE_DURATION=5m
SPIKE_SPIKE_DURATION=30s
# 22/08/2026: discover-concurrency.js mediu 0% de 429 ate 8 VUs e 26% de 429
# ja em 16 VUs nesta conta -> teto real entre 8 e 16. 5 = 8 * 0.7 (margem de
# seguranca). Reduza mais se voltar a ver 429 nos resultados; re-rode
# discover-concurrency.js se a conta/regiao mudar.
SPIKE_PEAK_VUS=5
SPIKE_CYCLES=3
# Duracao do stage de ramp-down logo apos cada pico (leva as VUs a 0
# rapidamente, em vez de deixar o k6 fazer isso gradualmente ao longo de
# todo o SPIKE_IDLE_DURATION seguinte - ver comentario em config/env.js).
SPIKE_RAMPDOWN_DURATION=2s

# Com um teto de concorrencia baixo (ver acima), go-cpu e quarkus-cpu juntos
# ao mesmo tempo (TARGETS=go-cpu,quarkus-cpu) somariam ate 2x SPIKE_PEAK_VUS
# de concorrencia contra a mesma conta -> deixe STAGGER_TARGETS=true para
# elas rodarem em sequencia (uma so comeca quando a outra termina todos os
# stages) em vez de em paralelo. Only necessario com mais de 1 target ativo.
STAGGER_TARGETS=true

# Perfil Discovery (achar o teto de concorrencia sem pedir aumento de cota)
DISCOVERY_VU_STEPS=1,2,4,8,16,32,64
DISCOVERY_STEP_DURATION=15s

# Perfil Load (warm start)
LOAD_RAMP_UP_DURATION=2m
LOAD_STEADY_DURATION=10m
LOAD_RAMP_DOWN_DURATION=2m
# Mesmo teto de concorrencia do spike se aplica aqui: LOAD_STEADY_VUS soma
# nas duas linguagens se TARGETS tiver mais de uma (e STAGGER_TARGETS nao
# ajuda aqui, porque o load e platô sustentado, nao rajada -- rode go e
# quarkus em execucoes k6 separadas se quiser manter os 50 originais, ou
# use um valor mais baixo como este para caber nos ~8 VUs de teto).
LOAD_STEADY_VUS=6

# Opcionais
HTTP_TIMEOUT=60s
GRACEFUL_RAMP_DOWN=30s
THRESHOLD_HTTP_FAIL_RATE=0.05
THRESHOLD_SUCCESS_RATE=0.95
THRESHOLD_P95_GO_MS=30000
THRESHOLD_P95_QUARKUS_MS=30000
